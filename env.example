# Database — local PostGIS (do not put production DSNs here)
# Local: postgresql://sv:sv@localhost:55432/sv
DATABASE_URL=postgresql://sv:sv@localhost:55432/sv
PG_DSN=postgresql://sv:sv@localhost:55432/sv

# API listens on 8888 locally and on Railway
PORT=8888
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://web-production-69f87.up.railway.app

# Frontend (Vite dev server talks to the API directly)
VITE_API_BASE_URL=http://localhost:8888

# Optional Clerk publishable key (pk_test_ for local/staging, pk_live_ for production).
# When unset, the map stays public. When set, the web app gates the map behind sign-in.
# Never commit secret keys. Railway sets this per environment.
# VITE_CLERK_PUBLISHABLE_KEY=

# Railway web service: nginx proxies /api to the API over private networking
# Set this on the web service, not in git:
# API_UPSTREAM=${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
