FROM node:20-alpine AS builder

WORKDIR /app

COPY web/package*.json ./
RUN npm ci

COPY web/ .
ARG VITE_API_BASE_URL=/api
ARG VITE_GIT_SHA
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# Prefer an explicit build arg; otherwise Railway/GitHub SHA from the build env.
RUN VITE_GIT_SHA="${VITE_GIT_SHA:-${RAILWAY_GIT_COMMIT_SHA:-${GIT_SHA:-${SOURCE_COMMIT:-dev}}}}" \
    npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY web/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY web/docker-entrypoint.sh /docker-entrypoint-sv.sh
RUN chmod +x /docker-entrypoint-sv.sh

ENV PORT=80
ENV API_UPSTREAM=api:8888

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint-sv.sh"]
